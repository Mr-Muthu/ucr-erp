# --- Database ---
DATABASE_URL="postgresql://ucr:ucr_password@localhost:5432/ucr_erp?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change_this_to_a_long_random_secret"
JWT_REFRESH_SECRET="change_this_to_a_different_long_random_secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
DRIVER_JWT_REFRESH_TTL="180d"

# --- Server ---
PORT=4000
NODE_ENV="development"
CLIENT_ORIGIN="http://localhost:5173"
TZ_DISPLAY="Asia/Kolkata"

# --- Redis (BullMQ + rate limiting) ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ucr-erp-documents"
R2_PRESIGN_EXPIRY_SECONDS=600

# --- Company / GST defaults (seeded, overridable via Settings table) ---
COMPANY_LEGAL_NAME="Ulagammal Car Rental"
COMPANY_GSTIN=""
COMPANY_STATE_CODE="27"
FINANCIAL_YEAR_START_MONTH=4

# --- Notifications (stubbed in Phase 1) ---
EXPO_ACCESS_TOKEN=""
RESEND_API_KEY=""

# --- Observability ---
SENTRY_DSN=""
